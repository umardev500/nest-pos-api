model User {
    id          Int      @id @default(autoincrement())
    fullname    String
    email       String   @unique
    password    String
    role        String   @default("user")
    merchant_id Int
    merchant    Merchant @relation(fields: [merchant_id], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}
